# Copying this file is not sufficient: run `python setup_lab.py` to generate a
# real Argon2id password hash and a random Flask session secret.
FLASK_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_FROM_SETUP
CYBER_LAB_USERNAME=lab-demo
CYBER_LAB_PASSWORD_HASH=REPLACE_WITH_AN_ARGON2ID_HASH

# 0 for the local HTTP-only lab. Set to 1 only when HTTPS is actually configured.
SESSION_COOKIE_SECURE=0
